ZJU_USERNAME=3240100000
ZJU_PASSWORD=your_passw0rd

# For pintia.cn (Optional)
# Automatically log in and renew the locally saved session.
PINTIA_USERNAME="your_email_or_phone"
PINTIA_PASSWORD="your_pintia_password"
# Optional fallback when username/password are not configured.
PINTIA_COOKIE=""

# For DingTalk notification(Optional)
ENABLE_DINGTALK=true # set to anything except "true" to disable
DINGTALK_WEBHOOK="https://oapi.dingtalk.com/robot/send?access_token=your_access_token"
DINGTALK_SECRET="SECyour_secret_token"

# For the grade monitor (Optional; defaults shown below)
GRADE_STATE_PATH="state/grades.json"
GRADE_MONITOR_START_HOUR=8
GRADE_MONITOR_END_HOUR=24
GRADE_MONITOR_INTERVAL_SECONDS=3600
GRADE_REQUEST_TIMEOUT_MS=20000
GRADE_NOTIFY_INITIAL=false
GRADE_CHECK_EVALUATION=true
